+  animation: intro-dark-open 5.2s cubic-bezier(0.72, 0, 0.2, 1) both;
+}
+.spider-intro::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: radial-gradient(ellipse at 50% 45%, #254c652e, transparent 45%);
+  pointer-events: none;
+}
+.intro-spider-drop {
+  background: none;
+  transform-origin: 50% 20%;
+  animation: spider-descend 1.5s cubic-bezier(0.18, 0.7, 0.3, 1) both;
+}
+.intro-spider-drop::before {
+  display: none;
+}
+.intro-header .eyebrow,
+.intro-edition,
+.intro-caption,
+.intro-footer,
+.intro-footer > button {
+  color: #a9c1cf;
+}
+.intro-registration {
+  color: #607e8f;
+}
+.intro-registration i {
+  background: linear-gradient(90deg, #75adcb20, transparent 25% 75%, #75adcb20);
+}
+.intro-thread {
+  height: calc(50% - var(--spider-size) * 0.27);
+  background: linear-gradient(#b6eeff00, #bee9ff99);
+  animation:
+    thread-descend 1.5s cubic-bezier(0.18, 0.7, 0.3, 1) both,
+    thread-retract 0.5s 1.65s ease-in forwards;
+}
+.intro-mark-position {
+  animation: intro-compose 1.2s 2.05s cubic-bezier(0.22, 0.8, 0.23, 1) both;
+}
+.intro-reference-spider {
+  z-index: 2;
+}
+.intro-name-reveal {
+  mix-blend-mode: normal;
+  color: #ddecf5;
+  left: 60%;
+  top: 44%;
+  width: 98%;
+  z-index: 1;
+}
+.intro-name-reveal span {
+  font-size: calc(var(--spider-size) * 0.18);
+  letter-spacing: 0.08em;
+  animation: even-emerge 1.2s 2.12s cubic-bezier(0.15, 0.8, 0.2, 1) both;
+}
+.intro-caption {
+  color: #6d94ac;
+  font-size: 8px;
+  top: calc(50% + var(--spider-size) * 0.68);
+  animation: intro-caption 0.8s 2.4s ease-out both;
+}
+.intro-progress {
+  background: #6e9bb626;
+}
+.intro-progress i {
+  background: #b7e5ff;
+  animation: intro-progress 4.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
+}
+.spider-intro :focus-visible {
+  outline: 2px solid #a5e2ff;
+}
+@keyframes intro-dark-open {
+  0%,
+  80% {
+    opacity: 1;
+    clip-path: inset(0 0 0 0);
+  }
+  100% {
+    opacity: 0;
+    clip-path: inset(0 0 100% 0);
+  }
+}
+
+/* Pages behave as successive windows in one quiet, silent operating system. */
+.app-page-frame {
+  transform-origin: 50% var(--switch-origin, 50svh);
+}
+.app-page-frame.page-leaving {
+  animation: app-leave 0.3s cubic-bezier(0.3, 0, 0.2, 1) both;
+  pointer-events: none;
+}
+.app-page-frame.page-entering {
+  animation: app-enter 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+.app-switch {
+  position: fixed;
+  z-index: 150;
+  inset: 0;
+  pointer-events: none;
+  opacity: 0;
+  visibility: hidden;
+  background: #02060ce6;
+  perspective: 1600px;
+  transition:
+    opacity 0.35s,
+    visibility 0.35s;
+}
+.app-switch.leaving {
+  opacity: 1;
+  visibility: visible;
+  transition: opacity 0.27s;
+}
+.app-switch.entering {
+  opacity: 0;
+  visibility: visible;
+  transition: opacity 0.48s;
+}
+.app-switch > i {
+  position: absolute;
+  inset: 9vh 8vw;
+  border: 1px solid #719daf30;
+  background: linear-gradient(120deg, #12253688, #030912);
+  border-radius: 18px;
+  transform: translate3d(2vw, 2vh, -70px) rotateY(-7deg);
+}
+.app-switch > i:nth-child(2) {
+  inset: 10vh 9vw;
+  transform: translate3d(-2vw, -2vh, -25px) rotateY(6deg);
+}
+.app-switch > span {
+  position: absolute;
+  left: 50%;
+  top: 48%;
+  transform: translate(-50%, -50%);
+  font: 10px var(--font-mono);
+  text-transform: uppercase;
+  letter-spacing: 0.25em;
+  color: #b4d9ed;
+}
+.app-switch > b {
+  position: absolute;
+  top: 53%;
+  left: calc(50% - 28px);
+  height: 1px;
+  width: 56px;
+  background: #b6e1f7;
+  transform-origin: left;
+}
+.app-switch.leaving > b {
+  animation: switch-thread 0.6s ease both;
+}
+@keyframes switch-thread {
+  from {
+    transform: scaleX(0);
+  }
+  to {
+    transform: scaleX(1);
+  }
+}
+@keyframes app-leave {
+  to {
+    opacity: 0.2;
+    transform: perspective(1800px) translate3d(-3vw, 0, -110px) rotateY(3deg);
+    filter: blur(3px);
+  }
+}
+@keyframes app-enter {
+  from {
+    opacity: 0;
+    transform: perspective(1800px) translate3d(4vw, 18px, -100px) rotateY(-3deg);
+    filter: blur(5px);
+  }
+  to {
+    opacity: 1;
+    transform: none;
+    filter: none;
+  }
+}
