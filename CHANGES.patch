+/* PARTICLE EDITION — restrained type, open compositions, one continuous signal. */
+.spider-mark {
+  width: 35px;
+  height: 42px;
+  filter: none;
+}
+.wordmark-letters {
+  font-size: 21px;
+  letter-spacing: 0.19em;
+}
+.global-header {
+  padding-block: 20px;
+}
+.header-scrolled {
+  background: #071019b8;
+  backdrop-filter: blur(20px);
+  border-color: #a2c7d51c;
+}
+.orb-entry-word {
+  font-size: 18px;
+  letter-spacing: 0.33em;
+  bottom: calc(50% - 166px);
+}
+.orb-entry-word span {
+  font-size: 7px;
+  margin-top: 13px;
+  letter-spacing: 0.2em;
+}
+.orb-skip {
+  border-color: #b1ccdb25;
+  background: #080c124d;
+}
+.screen-chapters {
+  position: relative;
+  isolation: isolate;
+}
+.screen-atmosphere {
+  position: absolute;
+  z-index: -1;
+  inset: 0;
+  overflow: hidden;
+  pointer-events: none;
+}
+.screen-atmosphere i {
+  position: absolute;
+  left: -25%;
+  top: 0;
+  width: 120%;
+  height: 48%;
+  border-radius: 50%;
+  background: radial-gradient(ellipse, #83bec511, transparent 65%);
+  filter: blur(40px);
+  animation: signal-haze 25s ease-in-out infinite alternate;
+}
+.screen-atmosphere i:last-child {
+  top: 48%;
+  left: 10%;
+  background: radial-gradient(ellipse, #dc91c312, transparent 66%);
+  animation-delay: -14s;
+}
+@keyframes signal-haze {
+  to {
+    transform: translate3d(8%, 9%, 0) scale(1.15);
+  }
+}
+.screen-chapters .story-chapter {
+  align-items: center;
+  min-height: max(800px, 112svh);
+  padding-block: 160px 130px;
+}
+.screen-chapters .chapter-copy {
+  transform: translate3d(0, calc((0.5 - var(--scene-progress, 0.5)) * 54px), 0);
+}
+.screen-chapters .chapter-copy h2 {
+  font-size: clamp(46px, 5.1vw, 88px);
+  font-weight: 400;
+  line-height: 1.04;
+  letter-spacing: -0.055em;
+  text-wrap: balance;
+}
+.screen-chapters .chapter-copy h2 span {
+  color: #b2c7d4;
+}
+.screen-chapters .chapter-copy > p:not(.eyebrow) {
+  color: #99acb9;
+  max-width: 290px;
+  font-size: 15px;
+}
+.immersed-chat {
+  align-self: center;
+  border-radius: 16px;
+  padding: clamp(24px, 3vw, 44px);
+  background: linear-gradient(145deg, #14242f8f, #070e167d);
+  border-color: #b7d5e329;
+  box-shadow:
+    0 25px 100px #0003,
+    inset 0 1px #d2e9f109;
+  transform: perspective(1600px)
+    rotateY(calc((0.5 - var(--scene-progress, 0.5)) * -8deg))
+    translate3d(0, calc((0.5 - var(--scene-progress, 0.5)) * -60px), 0);
+}
+.immersed-chat-top {
+  letter-spacing: 0.18em;
+  color: #bed2df;
+}
+.immersed-message.agent {
+  border-color: #93c8d820;
+  background: linear-gradient(115deg, #17333e66, #10172466);
+  border-radius: 12px 12px 12px 2px;
+}
+.immersed-message p {
+  font-size: clamp(18px, 1.7vw, 26px);
+  line-height: 1.48;
+}
+.immersed-compose {
+  background: #080e1566;
+  border-radius: 7px;
+  color: #bdd5e0;
+}
+.screen-chapters .flow-system {
+  max-width: 600px;
+  justify-self: end;
+  transform: translate3d(
+    0,
+    calc((0.5 - var(--scene-progress, 0.5)) * -40px),
+    0
+  );
+}
+.screen-chapters .flow-cards {
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+}
+.screen-chapters .flow-card {
+  display: flex;
+  align-items: center;
+  gap: 22px;
+  width: 100%;
+  min-height: 86px;
+  padding: 20px 16px;
+  border: 0;
+  border-bottom: 1px solid #a7c7d627;
+  border-radius: 0;
+  background: transparent;
+  box-shadow: none;
+  transition:
+    background 0.3s,
+    color 0.3s,
+    padding 0.3s;
+}
+.screen-chapters .flow-card:hover,
+.screen-chapters .flow-card.selected {
+  background: linear-gradient(90deg, #8acbd011, transparent);
+  padding-left: 24px;
+}
+.screen-chapters .flow-card > svg {
+  width: 22px;
+  height: 22px;
+  margin: 0;
+  color: #8caab9;
+}
+.screen-chapters .flow-card h3 {
+  font-size: clamp(24px, 2.6vw, 40px);
+  font-weight: 400;
+  letter-spacing: -0.04em;
+}
+.screen-chapters .flow-number {
+  position: static;
+  order: 3;
+  margin-left: auto;
+  font-size: 9px;
+}
+.screen-chapters .flow-card-line {
+  left: 0;
+  right: auto;
+  bottom: 25%;
+  top: 25%;
+  height: auto;
+  width: 2px;
+  background: #add9df;
+}
+.screen-chapters .workflow-example {
+  margin-top: 28px;
+  padding: 8px 0 8px 22px;
+  border-left: 1px solid #adcbd044;
+  background: transparent;
+}
+.screen-chapters .workflow-example .example-question {
+  font-size: 19px;
+  color: #d8e4ec;
+  line-height: 1.5;
+  margin-block: 10px;
+}
+.screen-chapters .companion-details {
+  gap: 20px;
+}
+.companion-details h3 {
+  font-size: 15px;
+  font-weight: 400;
+}
+.companion-details p {
+  color: #899fac;
+}
+.connection-field {
+  position: relative;
+  width: 100%;
+  max-width: 620px;
+  aspect-ratio: 1.2;
+  margin: auto;
+  min-height: 250px;
+}
+.connection-field canvas,
+.connection-fallback {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+.connection-fallback {
+  animation: signal-float 12s ease-in-out infinite alternate;
+}
+.connection-field[data-rendered="true"] .connection-fallback {
+  display: none;
+}
+@keyframes signal-float {
+  to {
+    transform: translateY(-12px) rotate(7deg);
+  }
+}
+.connection-label {
+  position: absolute;
+  z-index: 1;
+  font: 8px var(--font-mono);
+  letter-spacing: 0.15em;
+  color: #9db8c7;
+  padding: 10px 12px;
+  border: 1px solid #9ac9d323;
+  border-radius: 4px;
+  background: #091119a8;
+  backdrop-filter: blur(6px);
+}
+.label-knowledge {
+  left: 2%;
+  top: 29%;
+}
+.label-context {
+  right: 1%;
+  top: 44%;
+}
+.label-action {
+  left: 37%;
+  bottom: 15%;
+}
+.connection-core {
+  position: absolute;
+  left: 50%;
+  top: 48%;
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: #dce8ee;
+  box-shadow: 0 0 25px 6px #a1d1e32a;
+  animation: starlight 6s ease-in-out infinite alternate;
+}
+.continuity-emblem {
+  min-width: 0;
+  width: 100%;
+  transform: translate3d(
+    0,
+    calc((0.5 - var(--scene-progress, 0.5)) * -46px),
+    0
+  );
+}
+.continuity-emblem > span,
+.about-connection > span {
+  margin-top: 12px;
+  font-size: 8px;
+  color: #6f8a9d;
+  letter-spacing: 0.2em;
+}
+.about-connection {
+  min-width: 0;
+  width: 100%;
+  text-align: center;
+}
+.about-connection > span {
+  display: block;
+  font-family: var(--font-mono);
+}
+.layer-card,
+.module-detail,
+.principle,
+.concept-note,
+.purchase-panel,
+.demo-console-screen,
+.demo-context-rail,
+.plan-card,
+.contact-form {
+  border-color: #91aeb829;
+}
+.page-title h1 {
+  font-weight: 400;
+  letter-spacing: -0.055em;
+}
+.page-title > p:not(.eyebrow) {
+  color: #a2b4c2;
+  max-width: 450px;
+}
+.outline-pill,
+.primary-button,
+.text-link {
+  min-height: 44px;
+}
+.social-links a,
+.social-pending {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  min-height: 38px;
+  font-size: 12px;
+  color: #c8d4df;
+}
+.social-pending {
+  width: 100%;
+  color: #acbdc9;
+}
+.social-pending small {
+  margin-left: auto;
+  font: 7px var(--font-mono);
+  color: #748b9b;
+  letter-spacing: 0.08em;
