+    lower.push(p);
+  }
+  for (const p of unique.toReversed()) {
+    while (upper.length > 1 && cross(upper.at(-2), upper.at(-1), p) <= 0)
+      upper.pop();
+    upper.push(p);
+  }
+  return lower.slice(0, -1).concat(upper.slice(0, -1));
