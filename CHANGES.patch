+.social-links {
+  gap: 2px;
+}
+.footer-identity > p {
+  font-weight: 400;
+  letter-spacing: -0.04em;
+  line-height: 1.04;
+}
+.footer-newsletter label {
+  font-size: 18px;
+  font-weight: 400;
+  letter-spacing: -0.025em;
+}
+.footer-newsletter small {
+  font-size: 9px;
+  color: #839baa;
+}
+@media (max-width: 1000px) and (min-width: 701px) {
+  .screen-chapters .story-chapter {
+    gap: 36px;
+    grid-template-columns: 1fr 1fr;
+  }
+  .screen-chapters .chapter-copy h2 {
+    font-size: 50px;
+  }
