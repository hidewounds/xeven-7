+      getCurrentDirectory: () => dir,
+      getCanonicalFileName: (f) => f,
+      getNewLine: () => "\n",
+    }),
+  );
+const threeURL = pathToFileURL(
+  path.join(repo, "node_modules/three/build/three.module.js"),
+).href;
